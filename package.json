{
  "name": "grain",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "shots": "node scripts/scenes.mjs",
    "flows": "node scripts/flows.mjs",
    "soak": "node scripts/soak.mjs",
    "build:test": "vite build --outDir dist-test",
    "serve:test": "vite preview --outDir dist-test --port 5174 --strictPort",
    "layout": "node scripts/layout.mjs",
    "sim": "vitest run --config vitest.sim.config.ts",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/ios-setup.mjs",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "icons": "node scripts/icon.mjs"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
